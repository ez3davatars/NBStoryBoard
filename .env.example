# Renderer defaults (safe to commit)
VITE_DEFAULT_IMAGE_MODEL=gemini-2.0-flash-exp                                 
VITE_DEFAULT_ANALYSIS_MODEL=gemini-2.0-flash
VITE_DEFAULT_ASPECT_RATIO=16:9
VITE_DEFAULT_EXPORT_PRESET=1080p                                                                                                                            
                     
# Optional DEV ONLY (do not ship real keys, do not commit .env)                                                                     
VITE_DEV_GEMINI_API_KEY=

# Supabase Auth and hosted generation configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hosted generation worker and Edge Function secrets
GEMINI_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Supabase Edge Function secrets for checkout.
# Set Stripe price IDs as Supabase function secrets only. The desktop app sends
# stable product keys and must not contain Stripe price IDs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREDIT_PACK_100=
STRIPE_PRICE_CREDIT_PACK_500=
STRIPE_PRICE_INDIE_DESKTOP_BYOK=
STRIPE_PRICE_AGENCY_DESKTOP_BYOK=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_INDIE_UPDATES_SUPPORT=
STRIPE_PRICE_AGENCY_UPDATES_SUPPORT=
CHECKOUT_SUCCESS_URL=
CHECKOUT_CANCEL_URL=
STRIPE_CUSTOMER_PORTAL_RETURN_URL=

# Optional direct checkout URLs for legacy/public BYOK flows only.
# Credit packs intentionally do not use direct checkout URL fallback because
# their Checkout Sessions need authenticated user metadata for credit top-ups.
CHECKOUT_URL_INDIE_DESKTOP_BYOK=
CHECKOUT_URL_AGENCY_DESKTOP_BYOK=
