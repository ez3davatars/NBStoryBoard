# Renderer defaults (safe to commit)
VITE_DEFAULT_IMAGE_MODEL=gemini-2.0-flash-exp                                 
VITE_DEFAULT_ANALYSIS_MODEL=gemini-2.0-flash
VITE_DEFAULT_ASPECT_RATIO=16:9
VITE_DEFAULT_EXPORT_PRESET=1080p                                                                                                                            
                     
# Optional DEV ONLY (do not ship real keys, do not commit .env)                                                                     
VITE_DEV_GEMINI_API_KEY=

# Supabase Auth configuration (Required for Hosted Generation Mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Supabase Edge Function secrets for checkout.
# Configure either direct checkout URLs or Stripe Checkout price IDs.
CHECKOUT_URL_CREDIT_PACK_100=
CHECKOUT_URL_CREDIT_PACK_500=
CHECKOUT_URL_INDIE_DESKTOP_BYOK=
CHECKOUT_URL_AGENCY_DESKTOP_BYOK=
STRIPE_SECRET_KEY=
STRIPE_PRICE_CREDIT_PACK_100=
STRIPE_PRICE_CREDIT_PACK_500=
STRIPE_PRICE_INDIE_DESKTOP_BYOK=
STRIPE_PRICE_AGENCY_DESKTOP_BYOK=
CHECKOUT_SUCCESS_URL=
CHECKOUT_CANCEL_URL=
STRIPE_CUSTOMER_PORTAL_RETURN_URL=
